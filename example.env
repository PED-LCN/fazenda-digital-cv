FARM_CV_HOST=127.0.0.1
FARM_CV_PORT=8000
FARM_CV_DATABASE=./data/fazenda-cv.sqlite3
FARM_CV_DATA_DIR=./data
FARM_CV_EVIDENCE_RETENTION_DAYS=7
FARM_CV_FARM_ID=unidade-piloto
FARM_CV_CAMERA_ID=corredor-1
FARM_CV_TIMEZONE=America/Sao_Paulo
FARM_CV_LINE_START_X=0.5
FARM_CV_LINE_START_Y=1.0
FARM_CV_LINE_END_X=0.5
FARM_CV_LINE_END_Y=0.0
# Enable either a video source plus model, or synthetic detections for a demo.
# FARM_CV_CAMERA_SOURCE=rtsp://camera-address/stream
# FARM_CV_MODEL=./models/bovinos.onnx
# FARM_CV_CATTLE_CLASS_ID=19
# FARM_CV_DEMO=1
# Configure credentials and TLS certificate/key before binding to a LAN address.
# FARM_CV_USERNAME=operador
# FARM_CV_PASSWORD=change-this
# FARM_CV_TLS_CERT=./certs/local.crt
# FARM_CV_TLS_KEY=./certs/local.key
# ERP sync requires HTTPS and a bearer token.
# FARM_CV_ERP_EVENTS_URL=https://erp.example/api/cv/events
# FARM_CV_ERP_TOKEN=change-this
